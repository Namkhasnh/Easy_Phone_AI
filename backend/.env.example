# Copy to backend/.env (git-ignored, D-207). Every other setting has a default in app/config.py.
ENV=dev
OPENAI_API_KEY=
# Required: JWT keys come from {SUPABASE_URL}/auth/v1/.well-known/jwks.json (ES256, API_CONTRACT §2)
SUPABASE_URL=
# Optional: only for legacy HS256 tokens
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Thesis backend accepts local .storekit transactions (D-240, D-284)
ALLOW_XCODE_STOREKIT=true
