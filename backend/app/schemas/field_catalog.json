    {
      "kind": "call",
      "fields": [
        {
          "id": "recipientName",
          "type": "text",
          "deviceOnly": false,
          "appBuilt": false
        },
        {
          "id": "contactId",
          "type": "contactRef",
          "deviceOnly": true,
          "appBuilt": false
        },
        {
          "id": "phoneNumber",
          "type": "phone",
          "deviceOnly": true,
          "appBuilt": false
        }
      ],
      "required": [
        {
          "operation": "open",
          "requiresTargetRef": false,
          "fields": [
            "recipientName",
            "phoneNumber"
          ],
          "conditional": [
            {
              "when": [
                {
                  "type": "notPhoneNumber",
                  "field": "recipientName"
                }
              ],
              "fields": [
                "contactId"
              ]
            }
          ]
        }
      ]
    },
    {
      "kind": "sms",
      "fields": [
        {
          "id": "recipientName",
          "type": "text",
          "deviceOnly": false,
          "appBuilt": false
        },
        {
          "id": "contactId",
          "type": "contactRef",
          "deviceOnly": true,
          "appBuilt": false
        },
        {
          "id": "phoneNumber",
          "type": "phone",
          "deviceOnly": true,
          "appBuilt": false
        },
        {
          "id": "body",
          "type": "longText",
          "deviceOnly": false,
          "appBuilt": false
        },
        {
          "id": "channel",
          "type": "enumChoice",
          "deviceOnly": false,
          "appBuilt": false,
          "options": [
            "sms"
          ]
        }
      ],
      "required": [
        {
          "operation": "open",
          "requiresTargetRef": false,
          "fields": [
            "recipientName",
            "body",
            "channel"
          ],
          "conditional": [
            {
              "when": [
                {
                  "type": "equals",
                  "field": "channel",
                  "value": "sms"
                }
              ],
              "fields": [
                "phoneNumber"
              ]
            },
            {
              "when": [
                {
                  "type": "equals",
                  "field": "channel",
                  "value": "sms"
                },
                {
                  "type": "notPhoneNumber",
                  "field": "recipientName"
                }
              ],
              "fields": [
                "contactId"
              ]
            },
            {
              "when": [
                {
                  "type": "equals",
                  "field": "channel",
                  "value": "zalo"
                }
              ],
              "fields": [
                "phoneNumber"
              ]
            },
            {
              "when": [
                {
                  "type": "equals",
                  "field": "channel",
                  "value": "zalo"
                },
                {
                  "type": "notPhoneNumber",
                  "field": "recipientName"
                }
              ],
              "fields": [
                "contactId"
              ]
            }
          ]
        }
      ]
    },
    {
