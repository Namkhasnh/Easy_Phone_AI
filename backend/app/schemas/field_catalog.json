          ]
        },
        {
          "id": "customLabel",
          "type": "text",
          "deviceOnly": false,
          "appBuilt": false,
          "operations": [
            "create"
          ]
        },
        {
          "id": "mapsApp",
          "type": "enumChoice",
          "deviceOnly": false,
          "appBuilt": false,
          "options": [
            "appleMaps",
            "googleMaps"
          ],
          "operations": [
            "open"
          ]
        }
      ],
      "required": [
        {
          "operation": "create",
          "requiresTargetRef": false,
          "fields": [
            "query",
            "name",
            "address",
            "coordinate",
            "label"
          ],
          "conditional": [
            {
              "when": [
                {
                  "type": "equals",
                  "field": "label",
                  "value": "custom"
                }
              ],
              "fields": [
                "customLabel"
              ]
            }
          ]
        },
        {
          "operation": "open",
          "requiresTargetRef": false,
          "fields": [
            "query",
            "name",
            "address",
            "coordinate",
            "mapsApp"
          ],
          "conditional": []
        }
      ]
    },
