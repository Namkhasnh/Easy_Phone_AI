// Copy to Config/Secrets.xcconfig (git-ignored, D-207) and fill in.
// Supabase dashboard → Project Settings → API. Only the URL and the **anon** key — never the service-role key.
// Write `//` in URLs as `/$()/`.

SUPABASE_URL = https:/$()/YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY = YOUR-ANON-KEY

// Optional: tunnel URL for testing on a real iPhone (D-037).
// API_BASE_URL = https:/$()/YOUR-TUNNEL.example.com
